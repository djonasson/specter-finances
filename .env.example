VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Required by the spreadsheet picker (Google Picker API must be enabled)
VITE_GOOGLE_API_KEY=your-google-api-key
# Optional hint shown on the picker screen; the sheet you pick is what counts
VITE_SPREADSHEET_ID=your-spreadsheet-id-from-the-url
VITE_SHEET_NAME=Sheet1
